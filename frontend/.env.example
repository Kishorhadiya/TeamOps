# Vercel Frontend Environment Variables
# In Vercel Project Settings -> Environment Variables, add these with your deployed backend URLs:

# Admin backend base URL (Express app deployed on Vercel)
VITE_ADMIN_API_URL=https://your-admin-backend.vercel.app/api/v1

# User/Employee backend base URL (Express app deployed on Vercel)
VITE_BACKEND_API_URL=https://your-backend.vercel.app/api/v1

# Admin Leave router base URL
VITE_LEAVE_API_URL=https://your-admin-backend.vercel.app/leave
